# Copy to .env and fill in. .env is gitignored.

# === Elasticsearch (Cloud, v9.4+) ===
# The cluster URL, e.g. https://my-cluster.es.us-west-2.aws.elastic-cloud.com
ELASTICSEARCH_ENDPOINT=

# API key for the new vector-search cluster. Privileges needed:
#   - manage_inference   (to create / delete the embedding endpoint)
#   - read + write on the eui_icons index
ELASTICSEARCH_VECTOR_DB_API_KEY=

# === EUI repo (for the ingester) ===
# Override only if you want the ingester to clone from a fork. The clone
# location is always .cache/eui (gitignored, separate from any working
# checkout you may have at ~/git/...) and is not configurable.
EUI_REPO=https://github.com/elastic/eui.git

# === Optional: OpenTelemetry ===
# Leave empty to disable. Set to your OTel collector URL to enable.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=eui-embeddings-ingester
